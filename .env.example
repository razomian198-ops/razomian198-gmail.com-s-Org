# ==============================================================
# FACTINFOLIVE — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
#
# IMPORTANT:
# 1. Copy this file to '.env' on your server or hosting platform.
# 2. Never commit your '.env' file or real secret keys to public Git.
# 3. All keys below are read strictly SERVER-SIDE in server.ts.
#    They are never exposed to client browsers or bundled in Vite dist.
# ==============================================================

# Server Network & Hosting Configuration
PORT=3000
NODE_ENV=production
APP_URL=https://your-domain.com

# CORS Configuration
# - For unified full-stack deployments (same origin, e.g. Render, Railway, Fly.io, or VPS):
#   Leave as '*' or omit entirely. Browsers make same-origin requests directly to /api/*.
# - For split deployments (frontend on GitHub Pages and backend on a separate server):
#   Set to your frontend origin(s), comma-separated (e.g. CORS_ORIGIN=https://<your-github-username>.github.io).
CORS_ORIGIN=*

# Gemini AI API Key (Optional — for AI Research Assistant, Fact Audits & Translations)
# Free tier key available from Google AI Studio (https://aistudio.google.com)
GEMINI_API_KEY=

# News API Providers (Optional — Falls back to authenticated RSS wire syndication when omitted)
# Free API key from https://open-platform.theguardian.com/access/
GUARDIAN_API_KEY=
# Free tier key from https://gnews.io
GNEWS_API_KEY=

# Security: First-Time Master Admin Setup Authorization Token (Optional)
# If configured in your server environment, creating the initial administrator at /admin
# requires entering this secret token in the setup form. Protects public deployments
# against unauthorized first-admin registration.
# To generate a random 32-byte token locally, run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave empty if you are running locally or set it in your hosting platform dashboard.
SETUP_TOKEN=

# Monetization: Stripe Webhook Signing Secret (Optional — NOT CONFIGURED)
# Leave empty if you have not set up a Stripe webhook yet. Real payment verification
# is disabled (returns HTTP 503) until a genuine webhook signing secret (whsec_...) is provided.
STRIPE_WEBHOOK_SECRET=

# Database Connection (OPTIONAL / NOT REQUIRED — €0 Built-In Ledger)
# FactInfoLive does NOT require an external database (PostgreSQL, MySQL, Supabase, MongoDB, etc.).
# All articles, users, settings, and pledges persist to a zero-cost local JSON ledger (server/data/editorialStore.json).
# Leave this variable blank.
DATABASE_URL=
